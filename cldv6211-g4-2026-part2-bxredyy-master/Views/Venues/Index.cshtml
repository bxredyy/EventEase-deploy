@model IEnumerable<EventEase.Models.Venue>
@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building me-2 text-primary"></i>Venues</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-2"></i>Add Venue
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No venues found. <a asp-action="Create">Create your first venue.</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Venue Name</th>
                        <th>Location</th>
                        <th>Capacity</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var venue in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(venue.ImageUrl))
                                {
                                    <img src="@venue.ImageUrl" class="img-thumbnail-venue" alt="@venue.Name" />
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-image fs-4"></i></span>
                                }
                            </td>
                            <td class="fw-semibold align-middle">@venue.Name</td>
                            <td class="align-middle"><i class="bi bi-geo-alt text-muted me-1"></i>@venue.Location</td>
                            <td class="align-middle"><i class="bi bi-people text-muted me-1"></i>@venue.Capacity.ToString("N0")</td>
                            <td class="text-end align-middle">
                                <a asp-action="Details" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-info me-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
