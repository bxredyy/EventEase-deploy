@model IEnumerable<EventEase.Models.EventType>
@{
    ViewData["Title"] = "Event Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-tags me-2 text-info"></i>Event Types</h2>
    <a asp-action="Create" class="btn btn-info text-white">
        <i class="bi bi-plus-circle-fill me-2"></i>Add Event Type
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No event types found. <a asp-action="Create">Create your first event type.</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-center">Events Using It</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var et in Model)
                    {
                        <tr>
                            <td class="align-middle fw-semibold">
                                <span class="badge bg-info text-white">@et.Name</span>
                            </td>
                            <td class="align-middle text-muted">@et.Description</td>
                            <td class="align-middle text-center">
                                <span class="badge bg-secondary">@et.Events.Count</span>
                            </td>
                            <td class="text-end align-middle">
                                <a asp-action="Details" asp-route-id="@et.EventTypeId" class="btn btn-sm btn-outline-info me-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@et.EventTypeId" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@et.EventTypeId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
