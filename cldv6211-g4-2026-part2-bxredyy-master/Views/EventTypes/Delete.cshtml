@model EventEase.Models.EventType
@{
    ViewData["Title"] = "Delete Event Type";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Event Type?</h4>
            </div>
            <div class="card-body">
                <p>Are you sure you want to delete the event type <strong>@Model.Name</strong>?</p>

                @if (Model.Events.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle me-2"></i>
                        This category is used by <strong>@Model.Events.Count</strong> event(s).
                        Deleting it will leave those events untyped (they will remain in the system but without a category).
                    </div>
                }

                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="EventTypeId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
