@model EventEase.Models.BookingFormViewModel
@{
    ViewData["Title"] = "Edit Booking";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Booking</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingReference" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Booking Reference</label>
                        <input class="form-control bg-light" value="@Model.BookingReference" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="VenueId" class="form-label fw-semibold">Venue</label>
                        <select asp-for="VenueId" asp-items="Model.Venues" class="form-select">
                            <option value="">-- Select a Venue --</option>
                        </select>
                        <span asp-validation-for="VenueId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EventId" class="form-label fw-semibold">Event</label>
                        <select asp-for="EventId" asp-items="Model.Events" class="form-select" id="eventSelect">
                            <option value="">-- Select an Event --</option>
                        </select>
                        <span asp-validation-for="EventId" class="text-danger small"></span>
                    </div>

                    <div id="eventDatesPanel" class="alert alert-info @(Model.EventStartDate.HasValue ? "" : "d-none")">
                        <i class="bi bi-calendar-event me-2"></i>
                        <strong>Event scheduled:</strong>
                        <span id="eventDateDisplay">
                            @if (Model.EventStartDate.HasValue)
                            {
                                @Model.EventStartDate.Value.ToString("dd MMM yyyy")
                                if (Model.EventEndDate != Model.EventStartDate)
                                {
                                    <text> – @Model.EventEndDate!.Value.ToString("dd MMM yyyy")</text>
                                }
                            }
                        </span>
                        <br /><small class="text-muted">Booking dates are set automatically from the event schedule.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save me-2"></i>Update Booking
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('eventSelect').addEventListener('change', function () {
            const selected = this.options[this.selectedIndex];
            const panel = document.getElementById('eventDatesPanel');
            const display = document.getElementById('eventDateDisplay');

            if (selected.value) {
                const match = selected.text.match(/\((.+)\)$/);
                if (match) {
                    display.textContent = match[1];
                    panel.classList.remove('d-none');
                }
            } else {
                panel.classList.add('d-none');
            }
        });
    </script>
}
