@model IEnumerable<EventEase.Models.Booking>
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-check me-2 text-warning"></i>All Bookings</h2>
    <div class="d-flex gap-2">
        <a asp-action="Search" class="btn btn-outline-secondary">
            <i class="bi bi-search me-2"></i>Search
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill me-2"></i>New Booking
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No bookings yet. <a asp-action="Create">Create your first booking.</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Reference</th>
                        <th colspan="2">Venue</th>
                        <th>Event</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td class="align-middle"><span class="badge bg-primary">@booking.BookingReference</span></td>
                            <td class="align-middle" style="width:80px;">
                                @if (!string.IsNullOrEmpty(booking.Venue?.ImageUrl))
                                {
                                    <img src="@booking.Venue.ImageUrl" class="img-thumbnail-venue" alt="@booking.Venue.Name" />
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-building fs-4"></i></span>
                                }
                            </td>
                            <td class="align-middle fw-semibold">
                                @booking.Venue?.Name
                                <br /><small class="text-muted fw-normal"><i class="bi bi-geo-alt me-1"></i>@booking.Venue?.Location</small>
                            </td>
                            <td class="align-middle">@booking.Event?.Name</td>
                            <td class="align-middle">@booking.StartDate.ToString("dd MMM yyyy")</td>
                            <td class="align-middle">@booking.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end align-middle">
                                <a asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-info me-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
