@model EventEase.Models.BookingSearchViewModel
@{
    ViewData["Title"] = "Search Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-search me-2 text-secondary"></i>Search Bookings</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-2"></i>New Booking
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Search" method="get" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label class="form-label fw-semibold">Search by Booking ID, Booking Reference, Event Name, or Venue Name</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm"
                       class="form-control form-control-lg"
                       placeholder="e.g. EE-20260508 or Annual Gala or Grand Hall" />
            </div>
            <div class="col-md-3">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-search me-2"></i>Search
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-action="Search" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-2"></i>Clear
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <p class="text-muted">
        <i class="bi bi-filter me-2"></i>
        Showing <strong>@Model.Bookings.Count()</strong> result(s) for "<strong>@Model.SearchTerm</strong>"
    </p>
}

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        @if (string.IsNullOrEmpty(Model.SearchTerm))
        {
            <span>Enter a search term above to find bookings, or <a asp-action="Index">view all bookings</a>.</span>
        }
        else
        {
            <span>No bookings found matching "<strong>@Model.SearchTerm</strong>". Try a different search term.</span>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var booking in Model.Bookings)
        {
            <div class="col-md-6">
                <div class="card h-100 border-start border-primary border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary fs-6">@booking.BookingReference</span>
                            <span class="badge bg-secondary">ID: @booking.BookingId</span>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1"><i class="bi bi-building text-primary me-2"></i><strong>Venue</strong></p>
                                <p class="mb-1 text-muted">@booking.VenueName</p>
                                <p class="mb-1 small"><i class="bi bi-geo-alt me-1"></i>@booking.VenueLocation</p>
                                <p class="mb-1 small"><i class="bi bi-people me-1"></i>@booking.VenueCapacity.ToString("N0") guests</p>
                            </div>
                            <div class="col-6">
                                <p class="mb-1"><i class="bi bi-calendar3 text-success me-2"></i><strong>Event</strong></p>
                                <p class="mb-1 text-muted">@booking.EventName</p>
                                <p class="mb-1 small text-truncate">@booking.EventDescription</p>
                            </div>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col-6">
                                <small class="text-muted d-block">Start Date</small>
                                <strong>@booking.StartDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">End Date</small>
                                <strong>@booking.EndDate.ToString("dd MMM yyyy")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye me-1"></i>Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
