@model EventEase.Models.BookingSearchViewModel
@{
    ViewData["Title"] = "Search Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-search me-2 text-secondary"></i>Search Bookings</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-2"></i>New Booking
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Search" method="get">
            <div class="mb-2">
                <label class="form-label fw-semibold">Search Field</label>
                <div class="d-flex flex-wrap gap-2">
                    @{
                        var fields = new[]
                        {
                            ("", "All Fields", "bi-search"),
                            ("id", "Booking ID", "bi-hash"),
                            ("reference", "Reference", "bi-bookmark"),
                            ("event", "Event Name", "bi-calendar3"),
                            ("venue", "Venue Name", "bi-building")
                        };
                    }
                    @foreach (var (val, label, icon) in fields)
                    {
                        var active = (Model.SearchField ?? "") == val ? "btn-primary" : "btn-outline-secondary";
                        <a href="@Url.Action("Search", new { searchTerm = Model.SearchTerm, searchField = val })"
                           class="btn btn-sm @active">
                            <i class="bi @icon me-1"></i>@label
                        </a>
                    }
                </div>
            </div>

            <input type="hidden" name="searchField" value="@Model.SearchField" />

            <div class="row g-2 align-items-end mt-1">
                <div class="col-md-9">
                    @{
                        var placeholder = Model.SearchField switch
                        {
                            "id" => "e.g. 1 or 42",
                            "reference" => "e.g. EE-20260508-AB12CD",
                            "event" => "e.g. Annual Gala or Tech Summit",
                            "venue" => "e.g. Grand Hall or Sunset Pavilion",
                            _ => "Search by ID, reference, event name, or venue name…"
                        };
                    }
                    <input type="text" name="searchTerm" value="@Model.SearchTerm"
                           class="form-control form-control-lg"
                           placeholder="@placeholder" />
                </div>
                <div class="col-md-3">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-search me-2"></i>Search
                        </button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Search" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Clear
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    var fieldLabel = Model.SearchField switch
    {
        "id" => "Booking ID",
        "reference" => "Reference",
        "event" => "Event Name",
        "venue" => "Venue Name",
        _ => "All Fields"
    };
    <p class="text-muted mb-3">
        <i class="bi bi-filter me-1"></i>
        <strong>@Model.Bookings.Count()</strong> result(s) for
        "<strong>@Model.SearchTerm</strong>" in <strong>@fieldLabel</strong>
    </p>
}

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        @if (string.IsNullOrEmpty(Model.SearchTerm))
        {
            <span>Enter a search term above to find bookings, or <a asp-action="Index">view all bookings</a>.</span>
        }
        else
        {
            <span>No bookings found for "<strong>@Model.SearchTerm</strong>". Try a different term or search field.</span>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var booking in Model.Bookings)
        {
            <div class="col-md-6">
                <div class="card h-100 border-start border-primary border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary fs-6">@booking.BookingReference</span>
                            <span class="badge bg-secondary">ID: @booking.BookingId</span>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1"><i class="bi bi-building text-primary me-2"></i><strong>Venue</strong></p>
                                <p class="mb-1 text-muted">@booking.VenueName</p>
                                <p class="mb-1 small"><i class="bi bi-geo-alt me-1"></i>@booking.VenueLocation</p>
                                <p class="mb-1 small"><i class="bi bi-people me-1"></i>@booking.VenueCapacity.ToString("N0") guests</p>
                            </div>
                            <div class="col-6">
                                <p class="mb-1"><i class="bi bi-calendar3 text-success me-2"></i><strong>Event</strong></p>
                                <p class="mb-1 text-muted">@booking.EventName</p>
                                <p class="mb-1 small text-truncate">@booking.EventDescription</p>
                            </div>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col-6">
                                <small class="text-muted d-block">Start Date</small>
                                <strong>@booking.StartDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">End Date</small>
                                <strong>@booking.EndDate.ToString("dd MMM yyyy")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye me-1"></i>Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@booking.BookingId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
