@model IEnumerable<EventEase.Models.Event>
@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar3 me-2 text-success"></i>Events</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle-fill me-2"></i>Add Event
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No events found. <a asp-action="Create">Create your first event.</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(ev.ImageUrl))
                    {
                        <img src="@ev.ImageUrl" class="card-img-top" alt="@ev.Name" style="height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light text-center py-4">
                            <i class="bi bi-calendar3 display-4 text-muted"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@ev.Name</h5>
                        <p class="card-text text-muted small">
                            @(ev.Description?.Length > 100 ? ev.Description[..100] + "..." : ev.Description)
                        </p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <a asp-action="Edit" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
