@{
    ViewData["Title"] = "Error";
}
<div class="text-center mt-5">
    <h1 class="display-4 text-danger"><i class="bi bi-exclamation-octagon-fill"></i></h1>
    <h2>Something went wrong.</h2>
    <p class="lead">An unexpected error occurred. Please try again or return to the dashboard.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Dashboard</a>
</div>
